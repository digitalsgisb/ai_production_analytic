NODE_ENV=production
PORT=3000
PUBLIC_ORIGIN=https://ai.example.com
DATABASE_URL=postgresql://assistant_app:replace-me@production-postgres:5432/production_analytics
ASSISTANT_DB_PASSWORD=replace-with-the-same-database-password
POSTGRES_ADMIN_USER=production_admin
POSTGRES_DB=production_analytics
PRODUCTION_POSTGRES_CONTAINER=production-postgres
LANGFLOW_BASE_URL=http://langflow:7860
LANGFLOW_FLOW_ID=replace-with-flow-id
LANGFLOW_API_KEY=replace-on-atom-only
LANGFLOW_MOCK=false
SESSION_TTL_HOURS=24
LANGFLOW_TIMEOUT_MS=600000
POSTGRES_NETWORK=production-data_database
LANGFLOW_NETWORK=langflow_default
TUNNEL_TOKEN=replace-on-atom-only
